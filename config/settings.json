{
  "collapseChangelog": true,
  "defaultModel": "bubba",
  "defaultProvider": "vllm",
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-subagents@0.68.0",
    "npm:@nguyenquangthai/pi-ask@0.2.0",
    "npm:@tintinweb/pi-tasks@0.9.0",
    "npm:pi-powerline-footer@0.17.1",
    "npm:@narumitw/pi-btw@0.58.1",
    "npm:pi-lens@4.1.6",
    "npm:@sting8k/pi-vcc@0.7.2",
    "npm:pi-tool-display@0.5.0",
    "git:github.com/BubbatheVTOG/pi-boxed-tools@2262c69a2a21b1c8baf738b0efd85a52955aa156",
    "npm:pi-image-tools@1.4.0",
    "npm:pi-transcript-window@0.3.1",
    "git:github.com/BubbatheVTOG/pi-local-cloud-toggle@dbec6f20c193f063328f6747938a355c8b81d145",
    "git:github.com/BubbatheVTOG/agent-voice@d832560b90a022a534648014e6acedaf113ef4fe"
  ],
  "powerline": {
    "customItems": [
      {
        "excludeFromExtensionStatuses": true,
        "hideWhenMissing": true,
        "id": "agent-voice",
        "position": "right",
        "selfColorize": true,
        "statusKey": "agent-voice"
      },
      {
        "excludeFromExtensionStatuses": true,
        "hideWhenMissing": true,
        "id": "pi-local-cloud",
        "position": "right",
        "selfColorize": true,
        "statusKey": "pi-local-cloud"
      }
    ],
    "welcome": false
  },
  "quietStartup": true,
  "retry": {
    "baseDelayMs": 2000,
    "enabled": true,
    "maxRetries": 3,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "steeringMode": "all",
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "acceptanceRole": "read-only"
      },
      "oracle": {
        "thinking": "high"
      },
      "researcher": {
        "model": "inherit",
        "tools": "inherit"
      },
      "scout": {
        "model": "inherit"
      }
    },
    "agentOverridesByProvider": {
      "vllm": {
        "researcher": {
          "model": "lfm-vllm/bubba"
        },
        "scout": {
          "model": "lfm-vllm/bubba"
        }
      }
    }
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "hyper-term-white",
  "lastChangelogVersion": "0.85.1"
}
