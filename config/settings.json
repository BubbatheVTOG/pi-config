{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "collapseChangelog": true,
  "defaultModel": "bubba",
  "defaultProvider": "vllm",
  "hideThinkingBlock": true,
  "packages": [
    "npm:@weihannpmgo/pi-ask-user-question@1.0.0",
    "npm:@tintinweb/pi-tasks@0.9.1",
    "npm:pi-vim",
    "npm:pi-tool-display@0.5.0",
    "git:github.com/BubbatheVTOG/pi-boxed-tools@dfa1243f2c106d56b69f68c8fcfc9677ac0baa1a",
    "npm:pi-image-tools@1.4.0",
    "npm:pi-transcript-window@0.3.1",
    "git:github.com/BubbatheVTOG/pi-local-cloud-toggle@132dbada3c7a7b330ac587c3714ef11d3145970e",
    "git:github.com/BubbatheVTOG/agent-voice@ef40e297671f5379fd23e3f2f589a65938c66c1f",
    "git:github.com/BubbatheVTOG/pi-foot@a2ca5742911f47663854700a0110d7d9a609ab9b",
    "npm:pi-subagents@0.78.0",
    "npm:pi-lens@4.4.3",
    "npm:@narumitw/pi-cache-hit-monitor@0.1.1",
    "npm:pi-prefill",
    "npm:@sting8k/pi-vcc@0.10.2",
    "npm:pi-cache-optimizer@2.8.27",
    "git:github.com/BubbatheVTOG/pi-jev-anti-slop@5c474a91376a70931255f810892bb14d0868b37d",
    "git:github.com/BubbatheVTOG/pi-jev-tool-guard@defaf2d409ee38363644fd543c0f204dee64aa93",
    "git:github.com/BubbatheVTOG/pi-jev-redact@7a7faec62e0dfc83c583aaebd2d598850f4e15fe",
    "git:gitlab.com/bubbathevtog/pi-gitlab-duo-provider@021fb95e777a98795cda2c24369ddcb17e6aee47"
  ],
  "piFoot": {
    "order": [
      "model",
      "reasoning",
      "context",
      "cost",
      "tokens",
      "cloud",
      "voice",
      "cache",
      "lsp"
    ],
    "separator": " │ ",
    "colors": {
      "model": "muted",
      "reasoning": "muted",
      "context": "muted",
      "cost": "muted",
      "tokens": "muted",
      "cloud": "muted",
      "voice": "muted",
      "cache": "muted",
      "lsp": "muted",
      "separator": "accent"
    }
  },
  "piVim": {
    "borderSync": {
      "insert": "mode",
      "normal": "mode",
      "visual": "mode",
      "ex": "mode"
    }
  },
  "quietStartup": true,
  "showLastPrompt": false,
  "retry": {
    "baseDelayMs": 2000,
    "enabled": true,
    "maxRetries": 3,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "steeringMode": "all",
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "acceptanceRole": "read-only"
      },
      "oracle": {
        "thinking": "high"
      },
      "researcher": {
        "model": "inherit",
        "tools": "inherit"
      },
      "scout": {
        "model": "inherit"
      }
    },
    "agentOverridesByProvider": {
      "vllm": {
        "researcher": {
          "model": "lfm-vllm/bubba"
        },
        "scout": {
          "model": "lfm-vllm/bubba"
        }
      }
    }
  },
  "terminal": {
    "showTerminalProgress": true
  },
  "theme": "hyper-term-red",
  "toolGuard": {
    "disable": true
  },
  "lastChangelogVersion": "1.2.0",
  "prefill": {
    "views": [
      "label",
      "bar",
      "percent",
      "tokens",
      "tps",
      "eta"
    ],
    "providers": [
      "josh",
      "vllm"
    ]
  },
  "cacheWarming": "off"
}
